{
  "name": "melmccann/camel-config-bundle",
  "description": "Smartbox Camel Config Bundle",
  "type": "symfony-bundle",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Smartbox\\Integration\\CamelConfigBundle\\": ""
    }
  },
  "require": {
    "php": ">=8.4",
    "ext-pcntl": "*",
    "smartbox/integration-framework-bundle": "@stable",
    "symfony/config": "@stable",
    "symfony/console": "@stable",
    "symfony/dependency-injection": "@stable",
    "symfony/finder": "@stable",
    "symfony/form": "@stable",
    "symfony/framework-bundle": "@stable",
    "symfony/yaml": "@stable"
  },
  "require-dev": {
    "doctrine/annotations": "@stable",
    "doctrine/doctrine-bundle": "@stable",
    "doctrine/orm": "@stable",
    "jms/serializer-bundle": "@stable",
    "stomp-php/stomp-php": "@stable",
    "symfony/expression-language": "@stable",
    "symfony/http-kernel": "@stable",
    "symfony/monolog-bundle": "@stable",
    "symfony/options-resolver": "@stable",
    "symfony/phpunit-bridge": "*",
    "symfony/security-acl": "@stable"
  },
  "config": {
    "bin-dir": "bin",
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
